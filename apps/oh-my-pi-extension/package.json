{
  "name": "@plannotator/oh-my-pi-extension",
  "version": "0.26.2",
  "type": "module",
  "description": "Plannotator Oh My Pi extension - browser plan and code reviews",
  "author": "backnotprop",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/backnotprop/plannotator.git",
    "directory": "apps/oh-my-pi-extension"
  },
  "homepage": "https://github.com/backnotprop/plannotator",
  "bugs": {
    "url": "https://github.com/backnotprop/plannotator/issues"
  },
  "keywords": [
    "oh-my-pi",
    "omp",
    "plannotator",
    "plan-review",
    "code-review"
  ],
  "omp": {
    "extensions": [
      "./omp.ts"
    ]
  },
  "files": [
    "omp.ts",
    "annotation-commands.ts",
    "annotate-outcome.ts",
    "assistant-message.ts",
    "browser-session-error.ts",
    "plannotator-browser.ts",
    "plannotator-browser-runtime.ts",
    "plannotator-events.ts",
    "server.ts",
    "server/",
    "generated/",
    "README.md",
    "plannotator.html",
    "review-editor.html"
  ],
  "scripts": {
    "build": "cp ../hook/dist/index.html plannotator.html && cp ../hook/dist/review.html review-editor.html && bash vendor.sh",
    "prepublishOnly": "cd ../.. && bun run build:omp"
  },
  "dependencies": {
    "@joplin/turndown-plugin-gfm": "^1.0.64",
    "@pierre/diffs": "1.3.2",
    "@plannotator/webtui": "0.1.0",
    "chokidar": "^5.0.0",
    "diff": "^8.0.4",
    "parse5": "^7.3.0",
    "turndown": "^7.2.4"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": ">=17.2.0"
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": ">=17.2.0",
    "glimpseui": "^0.8.0"
  }
}
